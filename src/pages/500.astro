---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';

const title = 'Server Error — Free Touchscreen Test';
const description = 'Something went wrong on our end. Try refreshing the page, or head back to the homepage.';
---

<Layout title={title} description={description}>
	<section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-20 text-center sm:px-6 sm:py-28">
		<p class="font-mono text-caption uppercase tracking-wide text-mute">Error 500</p>
		<h1 class="mt-3 text-display-xl text-ink">Something went wrong</h1>
		<p class="mt-3 text-body-lg text-body">
			An unexpected error occurred on our end. It's not you &mdash; try refreshing, or come back in a moment.
		</p>

		<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
			<Button id="reload-btn" type="button">Try again</Button>
			<Button href="/" variant="secondary">Back to home</Button>
		</div>

		<p class="mt-10 text-body-sm text-mute">If this keeps happening, <a href="/contact-us/" class="text-ink underline underline-offset-2 hover:no-underline">let us know</a>.</p>
	</section>
</Layout>

<script>
	document.getElementById('reload-btn')?.addEventListener('click', () => {
		window.location.reload();
	});
</script>
