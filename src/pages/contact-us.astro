---
import Layout from '../layouts/Layout.astro';
import TestPageHeader from '../components/ui/TestPageHeader.astro';
import Card from '../components/ui/Card.astro';

const title = 'Contact Us — Free Touchscreen Test';
const description = 'Report a bug, suggest a feature, or ask a question about Free Touchscreen Test.';

const fieldClass =
	'w-full rounded-sm border border-hairline bg-canvas px-3 py-2 text-body-md text-ink placeholder:text-mute focus:border-ink focus:outline-none';
---

<Layout title={title} description={description} breadcrumb="Contact Us">
	<TestPageHeader
		eyebrow="Contact Us"
		title="Report a bug, or just say hi"
		description="Found something that doesn't work, or have a suggestion for a new test? Send it over."
	/>

	<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
		<!-- TODO: wire this form up to a submission backend (e.g. Formspree, Web3Forms)
		     before relying on it to actually deliver messages. -->
		<Card padding="xl">
			<form id="contact-form" class="space-y-5">
				<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
					<div>
						<label for="contact-name" class="mb-1.5 block text-body-sm-strong text-ink">Name</label>
						<input id="contact-name" name="name" type="text" required autocomplete="name" class={fieldClass} placeholder="Your name" />
					</div>
					<div>
						<label for="contact-email" class="mb-1.5 block text-body-sm-strong text-ink">Email</label>
						<input id="contact-email" name="email" type="email" required autocomplete="email" class={fieldClass} placeholder="you@example.com" />
					</div>
				</div>

				<div>
					<label for="contact-subject" class="mb-1.5 block text-body-sm-strong text-ink">Subject</label>
					<select id="contact-subject" name="subject" class={fieldClass}>
						<option>Bug report</option>
						<option>Feature suggestion</option>
						<option>General question</option>
						<option>Something else</option>
					</select>
				</div>

				<div>
					<label for="contact-message" class="mb-1.5 block text-body-sm-strong text-ink">Message</label>
					<textarea
						id="contact-message"
						name="message"
						required
						rows="5"
						class={fieldClass}
						placeholder="What's going on?"
					></textarea>
				</div>

				<button
					type="submit"
					class="inline-flex h-12 items-center justify-center gap-2 rounded-pill bg-primary px-5 text-button-lg text-on-primary transition-colors duration-150 hover:opacity-85"
				>
					Send message
				</button>
			</form>

			<p id="contact-success" class="hidden text-body-sm-strong text-ink" role="status">
				Thanks &mdash; your message has been noted. We read every submission.
			</p>
		</Card>
	</section>
</Layout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const success = document.getElementById('contact-success');

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		// No submission backend is wired up yet — see TODO in contact-us.astro.
		console.warn('Contact form: no submission endpoint configured yet.');
		form.classList.add('hidden');
		success?.classList.remove('hidden');
	});
</script>
