---
import Layout from '../layouts/Layout.astro';
import TestPageHeader from '../components/ui/TestPageHeader.astro';

const title = 'Terms & Conditions — Free Touchscreen Test';
const description =
	'The terms that apply when you use the free browser-based touchscreen diagnostic tools on Free Touchscreen Test.';

const lastUpdated = 'August 22, 2026';
---

<Layout title={title} description={description} breadcrumb="Terms & Conditions">
	<TestPageHeader
		eyebrow="Terms & Conditions"
		title="The fine print, kept short"
		description={`Last updated: ${lastUpdated}`}
	/>

	<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
		<div class="space-y-8 text-body-md text-body">
			<div>
				<h2 class="text-display-sm text-ink">1. Acceptance of terms</h2>
				<p class="mt-3">
					By accessing or using Free Touchscreen Test (the "Service") at freetouchscreentest.com, you
					agree to these Terms & Conditions. If you do not agree, please do not use the Service.
				</p>
			</div>

			<div>
				<h2 class="text-display-sm text-ink">2. Description of the service</h2>
				<p class="mt-3">
					The Service provides free, browser-based diagnostic tools for testing touchscreen behavior,
					including multi-touch tracking, gesture recognition, drawing, tap accuracy, dead-zone mapping,
					response latency, and scroll smoothness. The Service runs entirely client-side and requires no
					account, installation, or payment.
				</p>
			</div>

			<div>
				<h2 class="text-display-sm text-ink">3. Acceptable use</h2>
				<p class="mt-3">
					You agree to use the Service only for lawful purposes and in a way that does not disrupt,
					damage, or attempt to circumvent the normal operation of the Service or the systems it runs on,
					including attempts to probe, scan, or interfere with the Service's infrastructure.
				</p>
			</div>

			<div>
				<h2 class="text-display-sm text-ink">4. No warranty</h2>
				<p class="mt-3">
					The Service is provided "as is" and "as available," without warranties of any kind, express or
					implied. Test results are informational and intended to help you observe how your device's
					touchscreen behaves &mdash; they are not a certified diagnostic, a substitute for a
					manufacturer's official diagnostic tools, or a guarantee of your device's condition. Timing
					measurements (such as the latency test) reflect browser-level JavaScript timing and may include
					inherent jitter.
				</p>
			</div>

			<div>
				<h2 class="text-display-sm text-ink">5. Limitation of liability</h2>
				<p class="mt-3">
					To the fullest extent permitted by applicable law, we shall not be liable for any indirect,
					incidental, or consequential damages arising from your use of, or inability to use, the Service,
					including any decisions made based on test results.
				</p>
			</div>

			<div>
				<h2 class="text-display-sm text-ink">6. Intellectual property</h2>
				<p class="mt-3">
					The Service's design, code, and content are the property of Free Touchscreen Test unless
					otherwise noted. You may use the Service for personal and non-commercial diagnostic purposes.
					You may not copy, resell, or redistribute the Service itself without permission.
				</p>
			</div>

			<div>
				<h2 class="text-display-sm text-ink">7. Third-party links</h2>
				<p class="mt-3">
					The Service does not currently embed third-party advertising or tracking scripts. If any pages
					link to external resources in the future, we are not responsible for the content or practices of
					those external sites.
				</p>
			</div>

			<div>
				<h2 class="text-display-sm text-ink">8. Changes to the service or these terms</h2>
				<p class="mt-3">
					We may modify, suspend, or discontinue any part of the Service at any time, and may update these
					Terms from time to time. Material changes will be reflected by updating the "Last updated" date
					above. Continued use of the Service after a change constitutes acceptance of the revised Terms.
				</p>
			</div>

			<div>
				<h2 class="text-display-sm text-ink">9. Governing law</h2>
				<p class="mt-3">
					These Terms are governed by generally applicable principles of contract law. If any provision of
					these Terms is found unenforceable under the laws applicable to you, that provision will be
					limited or removed to the minimum extent necessary, and the remaining provisions will stay in
					full effect.
				</p>
			</div>

			<div class="rounded-lg border border-hairline bg-canvas-soft-2 p-6">
				<h2 class="text-display-sm text-ink">Questions?</h2>
				<p class="mt-3">If you have any questions about these Terms & Conditions, visit our <a href="/contact-us/" class="text-ink underline underline-offset-2 hover:no-underline">Contact Us</a> page.</p>
			</div>
		</div>
	</section>
</Layout>
