---
import ThemeToggle from '../ui/ThemeToggle.astro';

const links = [
	{ href: '/multi-touch-test/', label: 'Multi-Touch' },
	{ href: '/gesture-test/', label: 'Gestures' },
	{ href: '/draw-test/', label: 'Draw' },
	{ href: '/tap-accuracy-test/', label: 'Tap Accuracy' },
	{ href: '/dead-zone-test/', label: 'Dead Zones' },
	{ href: '/latency-test/', label: 'Latency' },
	{ href: '/scroll-test/', label: 'Scroll & Pan' },
];

const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas/90 backdrop-blur">
	<div class="mx-auto flex h-16 max-w-[1400px] items-center justify-between gap-4 px-4 sm:px-6">
		<a href="/" class="flex shrink-0 items-center gap-2 text-body-sm-strong text-ink">
			<span
				class="flex h-8 w-8 items-center justify-center rounded-sm bg-primary text-on-primary"
				aria-hidden="true"
			>
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
					<path
						d="M8 1.5c-.8 0-1.5.7-1.5 1.5v6.2l-1.3-1.3a1.25 1.25 0 0 0-1.9 1.6l3.6 4.4c.5.6 1.2 1 2 1h2.1a3 3 0 0 0 3-3V6.5a1.25 1.25 0 0 0-2.5 0V6a1.25 1.25 0 0 0-2.3-.7 1.25 1.25 0 0 0-2-.5V3c0-.8-.7-1.5-1.5-1.5Z"
						fill="currentColor"
					/>
				</svg>
			</span>
			<span>Free Touchscreen Test</span>
		</a>

		<nav class="hidden min-w-0 flex-1 items-center justify-center gap-1 overflow-x-auto lg:flex" aria-label="Tests">
			{
				links.map((link) => (
					<a
						href={link.href}
						class={`shrink-0 rounded-full px-3 py-1.5 text-body-sm transition-colors ${
							currentPath === link.href ? 'bg-canvas-soft-2 text-ink' : 'text-body hover:text-ink'
						}`}
						aria-current={currentPath === link.href ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="hidden shrink-0 items-center gap-2 lg:flex">
			<button
				type="button"
				id="nav-log-toggle"
				class="inline-flex h-8 items-center gap-1.5 rounded-sm border border-hairline bg-canvas px-2.5 text-body-sm-strong text-ink hover:bg-canvas-soft"
				aria-expanded="false"
			>
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path
						d="M2 3.5A1.5 1.5 0 0 1 3.5 2h9A1.5 1.5 0 0 1 14 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 12.5v-9Z"
						stroke="currentColor"
						stroke-width="1.3"
					/>
					<path d="M4.5 6h4M4.5 8.5h7M4.5 11h5.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
				</svg>
				Event Log
			</button>
			<ThemeToggle />
		</div>

		<button
			type="button"
			id="nav-mobile-toggle"
			class="flex h-9 w-9 shrink-0 items-center justify-center rounded-sm border border-hairline lg:hidden"
			aria-expanded="false"
			aria-label="Toggle menu"
		>
			<svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M2 4.5h12M2 8h12M2 11.5h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
			</svg>
		</button>
	</div>

	<div id="nav-mobile-menu" class="hidden border-t border-hairline bg-canvas lg:hidden">
		<nav class="flex flex-col gap-1 px-4 py-3" aria-label="Tests">
			{
				links.map((link) => (
					<a
						href={link.href}
						class={`rounded-sm px-2 py-2 text-body-sm-strong ${
							currentPath === link.href ? 'bg-canvas-soft-2 text-ink' : 'text-body'
						}`}
					>
						{link.label}
					</a>
				))
			}
			<button
				type="button"
				id="nav-log-toggle-mobile"
				class="mt-1 rounded-sm border border-hairline px-2 py-2 text-left text-body-sm-strong text-ink"
			>
				Event Log
			</button>
			<ThemeToggle class="mt-1" />
		</nav>
	</div>
</header>

<script>
	const mobileToggle = document.getElementById('nav-mobile-toggle');
	const mobileMenu = document.getElementById('nav-mobile-menu');

	mobileToggle?.addEventListener('click', () => {
		const isOpen = mobileMenu?.classList.toggle('hidden') === false;
		mobileToggle.setAttribute('aria-expanded', String(isOpen));
	});

	function openEventLog() {
		document.dispatchEvent(new CustomEvent('eventlog:open'));
		mobileMenu?.classList.add('hidden');
		mobileToggle?.setAttribute('aria-expanded', 'false');
	}

	document.getElementById('nav-log-toggle')?.addEventListener('click', openEventLog);
	document.getElementById('nav-log-toggle-mobile')?.addEventListener('click', openEventLog);
</script>
