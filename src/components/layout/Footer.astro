---
import { deviceLinks, testLinks } from '../../data/links';

const deviceLabels: Record<string, string> = {
	'/iphone-touch-screen-test/': 'iPhone',
	'/ipad-touch-screen-test/': 'iPad',
	'/android-touch-screen-test/': 'Android',
	'/laptop-touch-screen-test/': 'Laptop & Chromebook',
};

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas">
	<div class="mx-auto max-w-[1400px] px-4 py-16 sm:px-6 sm:py-24">
		<div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-6">
			<div class="col-span-2 sm:col-span-3 lg:col-span-1">
				<p class="text-body-sm-strong text-ink">Free Touchscreen Test</p>
				<p class="mt-2 text-body-sm text-body">
					A free, in-browser touchscreen diagnostic suite. No install, no signup, and your test data never leaves your device.
				</p>
			</div>
			<div>
				<p class="font-mono text-caption uppercase tracking-wide text-mute">Tests</p>
				<ul class="mt-3 flex flex-col gap-2">
					{
						testLinks.slice(0, 4).map((link) => (
							<li>
								<a href={link.href} class="text-body-sm text-body hover:text-ink">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<p class="font-mono text-caption uppercase tracking-wide text-mute">More tests</p>
				<ul class="mt-3 flex flex-col gap-2">
					{
						testLinks.slice(4).map((link) => (
							<li>
								<a href={link.href} class="text-body-sm text-body hover:text-ink">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<p class="font-mono text-caption uppercase tracking-wide text-mute">By device</p>
				<ul class="mt-3 flex flex-col gap-2">
					{
						deviceLinks.map((link) => (
							<li>
								<a href={link.href} class="text-body-sm text-body hover:text-ink">
									{deviceLabels[link.href] ?? link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<p class="font-mono text-caption uppercase tracking-wide text-mute">Company</p>
				<ul class="mt-3 flex flex-col gap-2">
					<li><a href="/about-us/" class="text-body-sm text-body hover:text-ink">About Us</a></li>
					<li><a href="/#faq" class="text-body-sm text-body hover:text-ink">FAQ</a></li>
					<li><a href="/contact-us/" class="text-body-sm text-body hover:text-ink">Contact Us</a></li>
					<li><a href="/" class="text-body-sm text-body hover:text-ink">Home</a></li>
				</ul>
			</div>
			<div>
				<p class="font-mono text-caption uppercase tracking-wide text-mute">Legal</p>
				<ul class="mt-3 flex flex-col gap-2">
					<li><a href="/privacy-policy/" class="text-body-sm text-body hover:text-ink">Privacy Policy</a></li>
					<li><a href="/terms-and-conditions/" class="text-body-sm text-body hover:text-ink">Terms &amp; Conditions</a></li>
				</ul>
			</div>
		</div>

		<div class="mt-12 flex flex-col gap-2 border-t border-hairline pt-6 text-caption text-mute sm:flex-row sm:items-center sm:justify-between">
			<p>&copy; {year} freetouchscreentest.com</p>
			<p>Runs entirely in your browser. Nothing you touch is uploaded anywhere.</p>
		</div>
	</div>
</footer>
