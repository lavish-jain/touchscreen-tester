---
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { deviceLinks, testLinks } from '../../data/links';

interface Props {
	title?: string;
	include?: 'tests' | 'devices' | 'all';
}

const { title = 'Keep testing your screen', include = 'all' } = Astro.props;

const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const pool = include === 'tests' ? testLinks : include === 'devices' ? deviceLinks : [...testLinks, ...deviceLinks];
const links = pool.filter((link) => link.href !== currentPath);
---

<section class="border-t border-hairline bg-canvas-soft py-16 sm:py-20">
	<div class="mx-auto max-w-[1400px] px-4 sm:px-6">
		<SectionHeader eyebrow="Related" title={title} />
		<ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				links.map((link) => (
					<li>
						<a href={link.href} class="group block h-full">
							<Card class="h-full transition-shadow group-hover:shadow-card-lg" padding="md">
								<p class="text-body-md-strong text-ink">{link.label}</p>
								<p class="mt-1 text-body-sm text-body">{link.description}</p>
							</Card>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
