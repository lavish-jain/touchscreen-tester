<div
	data-touch-only-notice
	class="mb-4 hidden items-center gap-2 rounded-md border border-warning-soft bg-warning-soft/50 px-3 py-2 text-body-sm text-warning-deep"
>
	<svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0" aria-hidden="true">
		<path
			d="M8 1.5 1 13.5h14L8 1.5Z"
			stroke="currentColor"
			stroke-width="1.3"
			stroke-linejoin="round"
		/>
		<path d="M8 6.5v3M8 11.5h.01" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
	</svg>
	<span>
		No touch input detected on this device. Open this page on a phone or tablet, or enable touch
		emulation in your browser's devtools, to run this test.
	</span>
</div>

<script>
	import { detectTouchCapabilities } from '../../scripts/touch-capabilities';

	if (!detectTouchCapabilities().supportsTouch) {
		document.querySelectorAll<HTMLElement>('[data-touch-only-notice]').forEach((el) => {
			el.classList.remove('hidden');
			el.classList.add('flex');
		});
	}
</script>
