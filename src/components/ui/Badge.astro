---
interface Props {
	variant?: 'default' | 'success' | 'warning' | 'error' | 'outline';
	class?: string;
	id?: string;
}

const { variant = 'default', class: className = '', id } = Astro.props;

const variants: Record<string, string> = {
	default: 'bg-canvas-soft-2 text-body',
	success: 'bg-link-bg-soft text-link-deep',
	warning: 'bg-warning-soft text-warning-deep',
	error: 'bg-error-soft text-error-deep',
	outline: 'border border-hairline bg-canvas text-ink',
};
---

<span
	id={id}
	class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-mono text-caption ${variants[variant]} ${className}`}
>
	<slot />
</span>
