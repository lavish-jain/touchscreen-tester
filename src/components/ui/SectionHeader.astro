---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	align?: 'left' | 'center';
	class?: string;
}

const { eyebrow, title, description, align = 'left', class: className = '' } = Astro.props;
---

<div class={`max-w-2xl ${align === 'center' ? 'mx-auto text-center' : ''} ${className}`}>
	{eyebrow && <p class="mb-2 font-mono text-caption uppercase tracking-wide text-mute">{eyebrow}</p>}
	<h2 class="text-display-lg text-ink">{title}</h2>
	{description && <p class="mt-3 text-body-lg text-body">{description}</p>}
</div>
