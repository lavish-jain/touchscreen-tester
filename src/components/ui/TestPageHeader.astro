---
interface Props {
	eyebrow?: string;
	title: string;
	description: string;
}

const { eyebrow = 'Touch Test', title, description } = Astro.props;
---

<div class="border-b border-hairline bg-canvas">
	<div class="mx-auto max-w-[1400px] px-4 py-10 sm:px-6 sm:py-14">
		<div class="flex flex-wrap items-start justify-between gap-6">
			<div class="max-w-2xl">
				<p class="mb-2 font-mono text-caption uppercase tracking-wide text-mute">{eyebrow}</p>
				<h1 class="text-display-lg text-ink sm:text-display-xl">{title}</h1>
				<p class="mt-3 text-body-lg text-body">{description}</p>
			</div>
			<div class="flex shrink-0 flex-wrap items-center gap-2">
				<slot name="actions" />
			</div>
		</div>
	</div>
</div>
